DATABASE_URL="postgresql://usuario@localhost:5432/nome_do_banco?schema=public"
JWT_SECRET="troque-esta-chave-por-uma-string-aleatoria-longa"
PORT=3333

# Agente de IA (WhatsApp) — Ollama local, compatível com API da OpenAI
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:e4b
LLM_BASE_URL="http://localhost:11434/v1"
LLM_API_KEY="ollama"
# Para usar a OpenAI direto: remova LLM_BASE_URL, defina LLM_MODEL com o nome do modelo e
# LLM_API_KEY com sua chave. Modelos de raciocínio (ex: gpt-5.x) exigem também
# LLM_REASONING_EFFORT=none para funcionar com as ferramentas (function calling).
HORARIO_ABERTURA=09:00
HORARIO_FECHAMENTO=19:00
# Lembrete de agendamento: enviado essa quantidade de minutos antes do horário marcado
# (opcional, padrão 60), conferindo a cada N minutos (opcional, padrão 10)
LEMBRETE_ANTECEDENCIA_MINUTOS=60
LEMBRETE_INTERVALO_VERIFICACAO_MINUTOS=10
# Evolution API (WhatsApp) — self-hosted via Docker, ver pasta evolution-api/
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="preencha-com-a-AUTHENTICATION_API_KEY-da-sua-evolution-api"
EVOLUTION_INSTANCE="nome-da-instancia"
WEBHOOK_TOKEN="uma-string-aleatoria-que-so-voce-e-a-evolution-api-conhecem"
